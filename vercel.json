{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:frontend && node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/v2/(.*)", "destination": "/api/__vh?__path=/v2/$1" },
    { "source": "/img", "destination": "/api/__vh?__path=/img" },
    { "source": "/health", "destination": "/api/__vh?__path=/health" },
    { "source": "/endpoints", "destination": "/api/__vh?__path=/endpoints" }
  ],
  "functions": {
    "api/**": { "maxDuration": 30 }
  }
}
